# Copie ce fichier en ".env" et remplis les valeurs (voir README.md étape par étape).

# --- Obligatoires ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Clé gratuite (palier permanent, pas un essai) sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Canal Telegram payant (optionnel) : voir README section "Monétiser".
# Laisse vide si tu ne veux pas diffuser vers un canal séparé.
TELEGRAM_CHANNEL_ID=

# URL brute du cache calendrier (voir .github/workflows/refresh-calendar.yml).
# Contourne un éventuel blocage de l'IP de ton hébergeur sur ForexFactory.
# Remplace <user>/<repo> par les tiens si tu as forké/renommé le dépôt.
GITHUB_CALENDAR_CACHE_URL=https://raw.githubusercontent.com/<user>/<repo>/cache-data/calendar_cache.json

# URL brute du cache FXStreet (voir .github/workflows/refresh-fxstreet.yml).
# Même principe : Render reçoit un 403 direct de FXStreet, pas la GitHub Action.
# Remplace <user>/<repo> par les tiens si tu as forké/renommé le dépôt.
FXSTREET_CACHE_URL=https://raw.githubusercontent.com/<user>/<repo>/cache-data/fxstreet_cache.json

# --- Optionnelles (recommandées, gratuites) ---
# Clé gratuite sur https://www.alphavantage.co/support/#api-key (25 requêtes/jour)
# Sert à récupérer le "résultat réel" (USD uniquement : NFP, CPI, Durable Goods,
# Retail Sales, Unemployment Rate) des news publiées. Sans elle : "indisponible".
ALPHAVANTAGE_API_KEY=

# Clé gratuite sur https://site.financialmodelingprep.com/register (250 requêtes/jour)
# Sert de secours si ForexFactory est indisponible (le calendrier lui-même).
FMP_API_KEY=

# Clé gratuite sur https://newsapi.org/register (100 requêtes/jour)
# Sert à la veille "breaking news" (tweets choc, conflits, discours surprise...).
NEWSAPI_KEY=

# Clé gratuite sur https://www.pexels.com/api/ (200 requêtes/heure, 20 000/mois)
# Sert de fond vidéo en boucle pour `python video_scripts.py --render` (voir README,
# section "Scripts vidéo courts"). Vide = fond uni par défaut, aucun blocage.
PEXELS_API_KEY=

# --- Réglages optionnels (valeurs par défaut déjà correctes) ---
TRADING_PAIRS=XAUUSD,EURUSD,GBPUSD,US30,BTCUSD,ETHUSD,DAX,SP500,NASDAQ,BRENT,CAC40
GEMINI_MODEL=gemini-3.1-flash-lite
DB_PATH=alerts.db
LOG_PATH=agent.log
PORT=8080
